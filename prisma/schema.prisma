// Prisma Schema for AI Tutor
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum ConceptState {
  NOT_STARTED
  INTRODUCED
  LEARNING
  GUIDED_PRACTICE
  INDEPENDENT_PRACTICE
  PROVISIONAL_MASTERY
  MASTERED
  REVIEW_REQUIRED
  PREREQUISITE_WEAKNESS
}

enum Difficulty {
  FOUNDATION
  EASY
  STANDARD
  CHALLENGING
  ADVANCED
}

enum MistakeCategory {
  CONCEPTUAL
  CALCULATION
  FORMULA
  SIGN
  MEMORY
  MISREADING
  CARELESS
  LOGICAL_REASONING
  INCOMPLETE
  LANGUAGE
  REPEATED_MISCONCEPTION
}

// User & Auth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  teacherProfile TeacherProfile?

  organizationMembers OrganizationMember[]
  classMembers        ClassMember[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Learning Digital Twin & Profiles
model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageRange            String?
  gradeLevel          String?  // e.g. "Class 10"
  curriculumBoard     String?  // e.g. "CBSE", "ICSE", "Maharashtra"
  preferredLanguage   String   @default("English")
  subjects            String?  // JSON string array of subjects
  learningGoals       String?  // JSON string
  targetScore         String?
  examDates           String?  // JSON string of exam dates
  availableStudyTime String?  // e.g. "45 min/day"
  confidenceBySubject String?  // JSON string
  preferredFormat     String?  // Step-by-step, Visual, Practice, etc.

  // Diagnostic & Mastery stats
  diagnosticCompleted Boolean  @default(false)
  overallMastery      Float    @default(0.0)
  totalStudyTimeMins  Int      @default(0)
  streakDays          Int      @default(0)

  masteryRecords      MasteryRecord[]
  mistakeRecords      MistakeRecord[]
  studyPlans          StudyPlan[]
  conversations       Conversation[]
  memories            Memory[]
  quizResults         QuizResult[]
  subscription        Subscription?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("student_profiles")
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent_profiles")
}

model TeacherProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String?
  schoolName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("teacher_profiles")
}

// Multi-Tenant School Infrastructure
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String?  @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  campuses  Campus[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role         @default(STUDENT)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Campus {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classes        Class[]
  createdAt      DateTime     @default(now())

  @@map("campuses")
}

model Class {
  id        String   @id @default(cuid())
  campusId  String
  name      String   // e.g. "10th Grade Sec-A"
  grade     String?
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  members   ClassMember[]
  createdAt DateTime @default(now())

  @@map("classes")
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  role      Role     @default(STUDENT)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_members")
}

// Curriculum Architecture
model Curriculum {
  id          String   @id @default(cuid())
  name        String   // e.g. "CBSE", "ICSE", "Maharashtra State Board", "JEE/NEET"
  code        String   @unique
  description String?
  isOfficial  Boolean  @default(false)
  grades      Grade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("curriculums")
}

model Grade {
  id           String     @id @default(cuid())
  curriculumId String
  name         String     // e.g. "Class 10", "Class 12"
  level        Int        // e.g. 10
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subjects     Subject[]

  @@map("grades")
}

model Subject {
  id        String    @id @default(cuid())
  gradeId   String
  name      String    // e.g. "Mathematics", "Science", "Physics"
  code      String?
  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  chapters  Chapter[]

  @@map("subjects")
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  order     Int      @default(1)
  name      String   // e.g. "Quadratic Equations"
  code      String?
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]

  @@map("chapters")
}

model Topic {
  id        String    @id @default(cuid())
  chapterId String
  order     Int       @default(1)
  name      String    // e.g. "Roots of Quadratic Equation"
  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  concepts  Concept[]

  @@map("topics")
}

model Concept {
  id          String   @id @default(cuid())
  topicId     String
  name        String   // e.g. "Discriminant & Nature of Roots"
  description String?
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  dependencies ConceptDependency[] @relation("DependentConcept")
  prerequisites ConceptDependency[] @relation("PrerequisiteConcept")

  masteryRecords MasteryRecord[]
  mistakeRecords MistakeRecord[]

  @@map("concepts")
}

model ConceptDependency {
  id                    String  @id @default(cuid())
  conceptId             String  // The concept requiring prerequisite
  prerequisiteConceptId String  // The required concept

  concept             Concept @relation("DependentConcept", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisiteConcept Concept @relation("PrerequisiteConcept", fields: [prerequisiteConceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteConceptId])
  @@map("concept_dependencies")
}

// Deterministic Mastery & Mistake Tracking
model MasteryRecord {
  id               String       @id @default(cuid())
  studentProfileId String
  conceptId        String
  state            ConceptState @default(NOT_STARTED)
  masteryScore     Float        @default(0.0)
  confidenceScore  Float        @default(0.0)
  retentionScore   Float        @default(1.0)
  evidenceCount    Int          @default(0)
  lastAssessedAt   DateTime     @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  concept        Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, conceptId])
  @@map("mastery_records")
}

model MistakeRecord {
  id               String          @id @default(cuid())
  studentProfileId String
  conceptId        String
  category         MistakeCategory @default(CONCEPTUAL)
  description      String
  frequency        Int             @default(1)
  lastSeen         DateTime        @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  concept        Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@map("mistake_records")
}

model StudyPlan {
  id               String         @id @default(cuid())
  studentProfileId String
  title            String
  targetDate       DateTime?
  planData         String?        // JSON string of daily breakdown
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@map("study_plans")
}

// System Administration & Feature Control
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Phase 2 Missing Models

model Tutor {
  id             String         @id @default(cuid())
  name           String
  description    String?
  systemPrompt   String?
  avatarId       String?
  voiceId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  avatar         Avatar?        @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  voice          Voice?         @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  conversations  Conversation[]

  @@map("tutors")
}

model Avatar {
  id             String    @id @default(cuid())
  name           String
  modelUrl       String
  thumbnailUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tutors         Tutor[]

  @@map("avatars")
}

model Voice {
  id             String    @id @default(cuid())
  name           String
  provider       String
  providerVoiceId String
  language       String    @default("en-IN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tutors         Tutor[]

  @@map("voices")
}

model Course {
  id             String    @id @default(cuid())
  title          String
  description    String?
  thumbnailUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  modules        Module[]

  @@map("courses")
}

model Module {
  id             String    @id @default(cuid())
  courseId       String
  title          String
  order          Int       @default(1)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons        Lesson[]

  @@map("modules")
}

model Lesson {
  id             String    @id @default(cuid())
  moduleId       String
  title          String
  order          Int       @default(1)
  content        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  module         Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]

  @@map("lessons")
}

model Conversation {
  id               String    @id @default(cuid())
  studentProfileId String
  tutorId          String?
  title            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  tutor            Tutor?         @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  messages         Message[]
  memories         Memory[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user", "assistant", "system"
  content        String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Memory {
  id               String       @id @default(cuid())
  conversationId   String?
  studentProfileId String
  content          String
  embedding        String?      // Can be used to store vector embeddings as JSON string or float array if DB supports it. Using string for now.
  createdAt        DateTime     @default(now())

  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("memories")
}

model Quiz {
  id             String       @id @default(cuid())
  lessonId       String
  title          String
  questions      String       // JSON string of questions
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results        QuizResult[]

  @@map("quizzes")
}

model QuizResult {
  id               String         @id @default(cuid())
  quizId           String
  studentProfileId String
  score            Float
  answers          String         // JSON string of answers given
  createdAt        DateTime       @default(now())

  quiz             Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model Subscription {
  id               String         @id @default(cuid())
  studentProfileId String         @unique
  planName         String         @default("FREE")
  status           String         @default("ACTIVE")
  startDate        DateTime       @default(now())
  endDate          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
